#!/usr/bin/env sh
# Git Bash wrapper; clset.cmd is the cmd/PowerShell one.
DIR="$(cd "$(dirname "$0")" && pwd)"
PS1="$(cygpath -w "$DIR/clset.ps1" 2>/dev/null || printf '%s\clset.ps1' "$DIR")"
if command -v pwsh >/dev/null 2>&1; then
    exec pwsh -NoProfile -ExecutionPolicy Bypass -File "$PS1" "$@"
else
    exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$PS1" "$@"
fi
